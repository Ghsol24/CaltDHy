# Dependencies — keep package.json and lockfiles in Git
node_modules/

# Generated build output and caches
dist/
dist-ssr/
build/
release/
.vite/
.cache/
coverage/
*.tsbuildinfo

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.pid.lock

# Local environment files at every directory level
# Only .env.example is eligible for tracking; review it for real secrets first.
.env
.env.*
!.env.example

# Local registry credentials and private key containers
.npmrc
.npmrc.*
*.key
*.pem
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519

# Local database exports and backups
caltdhy_db*.json
*.bson
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
/backups/
/exports/
/dump/

# Generated archives — reviewed source packaging is a separate step
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Test output
tests/last-run-results.json
playwright-report/
test-results/
.nyc_output/

# macOS / Windows metadata and editor temporary files
.DS_Store
._*
__MACOSX/
Thumbs.db
*.swp
*.swo
*~
