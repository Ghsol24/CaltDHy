# CaltDHy — cấu hình mẫu cho backend
#
# File này không chứa credential và được phép đưa vào Git/gói mã nguồn.
# Chỉ sao chép thành .env tại backEnd/server trên máy chạy ứng dụng.
# Điền bí mật trong .env riêng hoặc cấp qua biến môi trường của tiến trình.
# Biến môi trường đã được cấp cho tiến trình ưu tiên hơn giá trị trong .env.
# Không đưa .env thật vào Git, ZIP, app bundle hoặc thư mục frontend/dist.
# Không đặt bí mật trong biến VITE_* vì chúng có thể được đưa vào mã phía client.
#
# MONGODB_URI và JWT_SECRET cố ý để trống: phải cấu hình trước khi chạy.
# Backend sẽ từ chối khởi động nếu thiếu các giá trị bắt buộc này.

# Môi trường: production | development | test.
# Khi chạy backend cùng Vite ở máy phát triển, đổi thành development.
# Launcher macOS luôn cấp NODE_ENV=production cho backend.
NODE_ENV=production

# Chỉ lắng nghe trên máy cục bộ theo mặc định.
# Chỉ đổi HOST khi triển khai đã có kiểm soát truy cập mạng và HTTPS phù hợp.
# HOST phải là địa chỉ IP; không dùng tên miền.
# Launcher macOS luôn dùng cổng 24127.
HOST=127.0.0.1
PORT=24127

# URI MongoDB riêng của môi trường triển khai.
# Dùng tài khoản database có quyền tối thiểu cần thiết, không dùng tài khoản admin.
# Nếu username/password có ký tự đặc biệt, mã hóa URL cho từng thành phần.
# Bắt buộc replica set hoặc sharded cluster hỗ trợ transaction.
# Backend từ chối khởi động với MongoDB standalone.
# URI database phát triển minh họa, không phải cấu hình production:
# mongodb://127.0.0.1:27017/caltdhy_dev?replicaSet=rs0
MONGODB_URI=

# Tên biến được giữ để tương thích: khóa HMAC cho phiên opaque và CSRF.
# Backend không còn phát hành/chấp nhận bearer JWT.
# Tạo ngẫu nhiên, riêng cho từng môi trường, không dùng khóa mẫu.
# Backend yêu cầu tối thiểu 32 byte UTF-8; độ dài không thay thế tính ngẫu nhiên.
# Có thể tạo 32 byte ngẫu nhiên thành chuỗi hex 64 ký tự bằng lệnh:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
# Chỉ chạy trong terminal riêng; lưu kết quả vào nơi quản lý bí mật hoặc .env.
# Không đưa kết quả vào chat, log CI hoặc tài liệu dùng chung.
# Thay khóa sẽ khiến toàn bộ phiên cũ không còn hợp lệ.
JWT_SECRET=

# Luôn ghi đơn vị thời gian, ví dụ 1h; không dùng chuỗi số thiếu đơn vị.
# Thời hạn phiên máy chủ: tối thiểu 60 giây, tối đa 7 ngày. Không tự refresh.
JWT_EXPIRES_IN=1h

# Cookie luôn HttpOnly, SameSite=Strict; credential không lưu ở localStorage.
# Với website HTTPS (kể cả TLS kết thúc ở reverse proxy), đặt true.
# Launcher HTTP loopback cần false; không dùng true cho bản HTTP cục bộ.
# Khi HOST ngoài loopback hoặc CLIENT_URL là HTTPS, luôn bắt buộc Secure,
# kể cả khi biến này là false. Tách cấu hình web HTTPS và launcher HTTP.
# Mẫu chỉ lắng nghe loopback; đổi thành true khi triển khai web HTTPS.
COOKIE_SECURE=false

# URL giao diện dùng để tạo liên kết xác minh email/đặt lại mật khẩu.
# Production yêu cầu URL HTTPS thực tế do bạn kiểm soát.
# Không chứa username, password, query hoặc fragment.
# Ví dụ production: https://finance.example.com
# Khi NODE_ENV=development và dùng Vite: http://localhost:5173
# Launcher chạy production nên không được dùng ngoại lệ HTTP development
# cho liên kết email, dù giao diện cục bộ được mở tại http://localhost:24127.
# Để trống thì các luồng gửi liên kết email chưa hoạt động.
CLIENT_URL=

# Origin bổ sung được phép gọi API, phân cách bằng dấu phẩy.
# Chỉ ghi scheme + hostname + port (nếu có); không có path hoặc wildcard.
# Ví dụ: https://finance.example.com,https://admin.example.com
# Trong production, origin ngoài loopback phải dùng HTTPS.
# Backend tự thêm origin của CLIENT_URL và các origin loopback của PORT.
# Để trống nếu không cần origin bổ sung; không đồng nghĩa cho phép mọi origin.
CORS_WHITELIST=

# Production mặc định chỉ cho đăng ký bằng liên kết mời; development/test mặc định mở.
# invite: token một lần, gắn với email, hết hạn. open: cho phép đăng ký công khai.
# Chỉ dùng open cho dịch vụ công khai khi thật sự muốn ai cũng tạo tài khoản.
REGISTRATION_MODE=invite

# Giới hạn số request theo IP trong cửa sổ 15 phút.
# API_RATE_LIMIT_MAX áp dụng cho mọi API; API auth còn chịu AUTH_RATE_LIMIT_MAX.
# Giá trị phải là số nguyên dương; tối đa lần lượt là 100000 và 1000.
# Bộ đếm hiện lưu riêng trong mỗi tiến trình, chưa dùng chung giữa nhiều instance.
# Mặc định backend không tin header proxy để xác định IP; triển khai sau reverse proxy
# cần cấu hình chính xác số lớp proxy và chặn kết nối trực tiếp tới backend.
# Chỉ đặt 1-3 khi biết rõ chuỗi proxy tin cậy; sai số lớp có thể làm giả IP
# hoặc gộp mọi người dùng vào cùng một giới hạn. Mặc định 0 cho máy cục bộ.
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Tài khoản gửi email cho transport Gmail hiện có.
# GMAIL_PASS là App Password được cấp cho ứng dụng, không phải mật khẩu đăng nhập.
# Để trống nếu chưa cấu hình gửi email; cần cả hai giá trị và CLIENT_URL hợp lệ.
# API quên mật khẩu trả thông báo chung, không phải xác nhận email đã được gửi.
GMAIL_USER=
GMAIL_PASS=

# Không đặt cấu hình chạy cleanup/seed/migration trong file mẫu ứng dụng này.
# Các script đã được sửa dùng URI và tham số riêng, không tự nạp .env ứng dụng.
# Chỉ cấp các tham số đó cho lần chạy quản trị đã xác định rõ phạm vi.
