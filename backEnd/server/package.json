{
  "name": "projectcanhan-server",
  "version": "1.0.0",
  "description": "Backend cho website quản lý lịch trình cá nhân projectcanhan",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:email": "node scripts/migrate-email-verified.js",
    "migrate:dates": "node scripts/migrate-transaction-dates.js",
    "migrate:categories": "node scripts/migrate-budget-categories.js",
    "migrate:categories-collection": "node scripts/migrate-categories-to-collection.js",
    "migrate:jar-transfers": "node scripts/migrate-jar-transfer-types.js",
    "test:integration": "node --test --test-concurrency=1 tests/*.test.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "nodemailer": "10.0.10"
  },
  "overrides": { "qs": "6.16.0" },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
